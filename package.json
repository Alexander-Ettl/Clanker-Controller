{
  "name": "clanker-controller",
  "private": true,
  "license": "MPL-2.0",
  "bin": { "router": "scripts/router.cjs" },
  "type": "module",
  "description": "Clanker Controller, native voice routing, and CLI usage status.",
  "scripts": {
    "install:extension": "node scripts/install-extension.mjs",
    "check": "node ai-chat-panel/test/check.js",
    "test": "node --test ai-chat-panel/test/*.test.js antigravity-usage-statusbar/test/usage.test.js",
    "render": "node ai-chat-panel/test/render.mjs",
    "verify:models": "node scripts/verify-model-provider-identity.mjs",
    "verify:investigations": "node scripts/investigation-smoke.cjs",
    "verify:bridge": "node scripts/verify-visor-bridge.mjs",
    "test:loops-ui": "node ai-chat-panel/test/investigations-ui.mjs",
    "test:compliance-ui": "node ai-chat-panel/test/compliance-settings.mjs",
    "test:voice-ui": "node ai-chat-panel/test/voice-start.mjs",
    "test:auth-ui": "node ai-chat-panel/test/auth-hold-ui.mjs && node ai-chat-panel/test/rail-fault-ui.mjs",
    "test:ui": "node ai-chat-panel/test/ui-tester/run.mjs",
    "test:ui-tester": "node ai-chat-panel/test/ui-tester.mjs"
  },
  "devDependencies": { "playwright": "^1.55.0" }
}
