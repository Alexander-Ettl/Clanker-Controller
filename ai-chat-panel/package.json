{
    "name": "ai-chat-panel",
    "displayName": "AI Chat Panel",
    "description": "Unified Liquid Glass launcher for headless Claude Code, Codex, and Gemini 3.8 chat sessions, opened as movable floating windows alongside the File Explorer.",
    "version": "0.1.0",
    "publisher": "local",
    "private": true,
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "aiChatPanel",
                    "title": "AI Chat Panel",
                    "icon": "media/icon.svg"
                }
            ]
        },
        "views": {
            "aiChatPanel": [
                {
                    "type": "webview",
                    "id": "aiChatPanel.mainView",
                    "name": "Launcher"
                }
            ]
        },
        "commands": [
            {
                "command": "aiChatPanel.open",
                "title": "AI Chat Panel: Open",
                "icon": "$(comment-discussion)"
            },
            {
                "command": "aiChatPanel.newChatWindow",
                "title": "AI Chat Panel: New Chat Window",
                "icon": "$(add)"
            },
            {
                "command": "aiChatPanel.injectPrompt",
                "title": "AI Chat Panel: Inject Prompt"
            },
            {
                "command": "aiChatPanel.setupVisualEditor",
                "title": "Astro Visual Editor: Set Up in This Folder"
            },
            {
                "command": "aiChatPanel.routePrompt",
                "title": "AI Chat Panel: Route Prompt to a Site-Edit Chat"
            },
            {
                "command": "aiChatPanel.runNextBatchInCleanSession",
                "title": "AI Chat Panel: Run Next Batch in Clean Session"
            },
            {
                "command": "aiChatPanel.focusClaude",
                "title": "AI Chat Panel: Focus Claude"
            },
            {
                "command": "aiChatPanel.focusCodex",
                "title": "AI Chat Panel: Focus Codex"
            },
            {
                "command": "aiChatPanel.focusGemini",
                "title": "AI Chat Panel: Focus Gemini 3.8"
            },
            {
                "command": "aiChatPanel.focusOpus",
                "title": "AI Chat Panel: Open Claude Opus 5.5 Terminal"
            },
            {
                "command": "aiChatPanel.configureTelegram",
                "title": "AI Chat Panel: Configure Telegram Remote Control"
            },
            {
                "command": "aiChatPanel.startTunnel",
                "title": "AI Chat Panel: Start Cloudflare Tunnel"
            },
            {
                "command": "aiChatPanel.stopTunnel",
                "title": "AI Chat Panel: Stop Cloudflare Tunnel"
            },
            {
                "command": "aiChatPanel.addToChat",
                "title": "Add to AI Chat",
                "icon": "$(comment-discussion)"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "aiChatPanel.addToChat",
                    "group": "navigation@99"
                }
            ],
            "editor/title/context": [
                {
                    "command": "aiChatPanel.addToChat",
                    "group": "navigation@99"
                }
            ],
            "commandPalette": [
                {
                    "command": "aiChatPanel.addToChat",
                    "when": "false"
                }
            ]
        },
        "configuration": {
            "title": "AI Chat Panel",
            "properties": {
                "aiChatPanel.timeFormat": {
                    "type": "string",
                    "enum": ["auto", "24h", "12h"],
                    "default": "24h",
                    "markdownDescription": "Clock format for times in the chat panel and launcher. `auto` follows the editor's display language."
                },
                "aiChatPanel.models": {
                    "type": "object",
                    "default": {
                        "claude": "claude",
                        "codex": "gpt-5.6-terra",
                        "gemini": "gemini-3.8-flash-high"
                    },
                    "description": "CLI model identifiers used by the headless AI Chat Panel."
                }
            }
        }
    },
    "scripts": {
        "check": "node test/check.js",
        "test": "node test/check.js && node test/session.test.js"
    },
    "extensionKind": [
        "ui"
    ]
}
