{
    "name": "ai-chat-panel",
    "displayName": "Clanker Controller",
    "description": "Unified Liquid Glass launcher for headless Claude Code, Codex, and Gemini 3.8 chat sessions, opened as movable floating windows alongside the File Explorer.",
    "version": "0.1.0",
    "publisher": "local",
    "private": true,
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "*",
        "onWebviewPanel:aiChatPanel.chatWindow"
    ],
    "main": "./extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "aiChatPanel",
                    "title": "Clanker Controller",
                    "icon": "media/clanker.svg"
                }
            ],
            "secondarySidebar": [
                {
                    "id": "aiChatPanelChat",
                    "title": "Clanker Controller",
                    "icon": "media/clanker.svg"
                }
            ]
        },
        "views": {
            "aiChatPanel": [
                {
                    "type": "webview",
                    "id": "aiChatPanel.mainView",
                    "name": "Clanker Controller"
                }
            ],
            "aiChatPanelChat": [
                {
                    "type": "webview",
                    "id": "aiChatPanel.chatView",
                    "name": "Clanker Controller"
                }
            ]
        },
        "commands": [
            {
                "command": "aiChatPanel.open",
                "title": "Clanker Controller:Open",
                "icon": "$(comment-discussion)"
            },
            {
                "command": "aiChatPanel.newChatWindow",
                "title": "Clanker Controller:New Chat Window",
                "icon": "$(add)"
            },
            {
                "command": "aiChatPanel.injectPrompt",
                "title": "Clanker Controller:Inject Prompt"
            },
            {
                "command": "aiChatPanel.routePrompt",
                "title": "Clanker Controller:Route Prompt to a Routed-Prompts Chat"
            },
            {
                "command": "aiChatPanel.runNextBatchInCleanSession",
                "title": "Clanker Controller:Run Next Batch in Clean Session"
            },
            {
                "command": "aiChatPanel.focusClaude",
                "title": "Clanker Controller:Focus Claude"
            },
            {
                "command": "aiChatPanel.focusCodex",
                "title": "Clanker Controller:Focus Codex"
            },
            {
                "command": "aiChatPanel.focusGemini",
                "title": "Clanker Controller:Focus Gemini 3.8"
            },
            {
                "command": "aiChatPanel.focusOpus",
                "title": "Clanker Controller:Open Claude Opus 5.5 Terminal"
            },
            {
                "command": "aiChatPanel.configureTelegram",
                "title": "Clanker Controller:Configure Telegram Remote Control"
            },
            {
                "command": "aiChatPanel.startTunnel",
                "title": "Clanker Controller:Start Cloudflare Tunnel"
            },
            {
                "command": "aiChatPanel.stopTunnel",
                "title": "Clanker Controller:Stop Cloudflare Tunnel"
            },
            {
                "command": "aiChatPanel.addToChat",
                "title": "Add to Clanker Controller",
                "icon": "$(comment-discussion)"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "aiChatPanel.addToChat",
                    "group": "navigation@99"
                }
            ],
            "editor/title/context": [
                {
                    "command": "aiChatPanel.addToChat",
                    "group": "navigation@99"
                }
            ],
            "commandPalette": [
                {
                    "command": "aiChatPanel.addToChat",
                    "when": "false"
                }
            ]
        },
        "configuration": {
            "title": "Clanker Controller",
            "properties": {
                "aiChatPanel.timeFormat": {
                    "type": "string",
                    "enum": ["auto", "24h", "12h"],
                    "default": "24h",
                    "markdownDescription": "Clock format for times in the chat panel and launcher. `auto` follows the editor's display language."
                },
                "aiChatPanel.showStatusBar": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Show Clanker Controller's item (the Cloudflare tunnel state) in the status bar at the bottom of the window."
                },
                "aiChatPanel.permissionMode": {
                    "type": "string",
                    "enum": ["ask", "auto", "fullAccess"],
                    "default": "fullAccess",
                    "markdownDescription": "Permission mode across Claude, Codex, and Gemini: `ask` requests approval where the provider supports prompts, `auto` uses automated risk review where supported, and `fullAccess` allows automatic execution. Headless Gemini skips actions requiring approval in `ask` and `auto`."
                },
                "aiChatPanel.verifyCommand": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "What Auto-Verify (the check-mark button beside the composer's clock) tells the agent to run after it changes files, for example `npm test`. Empty: the agent finds the project's own test or verify command."
                },
                "aiChatPanel.architectModel": {
                    "type": "string",
                    "enum": ["claude-opus-5-5-medium", "claude-sonnet-5-5-high", "gpt-6.1-sol-high", "gpt-6-astra-high", "gpt-6-luna-high", "gemini-3.8-flash-high"],
                    "default": "claude-opus-5-5-medium",
                    "markdownDescription": "The model that plans when you send `/architect <task>`. It reads the code and writes a plan, and edits nothing."
                },
                "aiChatPanel.editorModel": {
                    "type": "string",
                    "enum": ["claude-opus-5-5-medium", "claude-sonnet-5-5-high", "gpt-6.1-sol-high", "gpt-6-astra-high", "gpt-6-luna-high", "gemini-3.8-flash-high"],
                    "default": "gpt-6.1-sol-high",
                    "markdownDescription": "The model that builds the plan after `/architect`. It starts by itself when the plan is done."
                },
                "aiChatPanel.droidSounds": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Clanker's own sound when a turn ends: a rising astromech chirp when it's done, a low warble when the agent reports an error. Synthesized in the chat window (no audio files). Off by default; the completion chime your CLI hooks play is separate."
                },
                "aiChatPanel.models": {
                    "type": "object",
                    "default": {
                        "claude": "claude",
                        "codex": "gpt-6.1-sol",
                        "gemini": "gemini-3.8-flash-high"
                    },
                    "description": "CLI model identifiers used by the headless Clanker Controller."
                }
            }
        }
    },
    "scripts": {
        "check": "node test/check.js",
        "test": "node test/check.js && node test/session.test.js && node test/turn-undo.test.js && node test/turn-extras.test.js"
    },
    "extensionKind": [
        "ui"
    ]
}
