#!/usr/bin/env bash
# Starts or stops Clanker dictation in the editor window used last. Bind this to a global shortcut:
#   KDE:   System Settings > Keyboard > Shortcuts > Add New > Command or Script > path to this file
#   GNOME: Settings > Keyboard > Custom Shortcuts
# Pressing it once starts recording, pressing it again stops and transcribes. Needs the Clanker Controller extension running.
set -u
dir="${XDG_RUNTIME_DIR:-/tmp}"

send() { # $1 = socket; prints the answer
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$1" <<'PY'
import socket, sys
try:
    s = socket.socket(socket.AF_UNIX); s.settimeout(2); s.connect(sys.argv[1]); s.sendall(b"toggle\n"); print(s.recv(16).decode().strip())
except OSError:
    sys.exit(1)
PY
  elif command -v socat >/dev/null 2>&1; then
    printf 'toggle\n' | socat - "UNIX-CONNECT:$1" 2>/dev/null
  else
    printf 'toggle\n' | nc -U -w 2 "$1" 2>/dev/null
  fi
}

if [ -n "${CLANKER_DICTATE_SOCKET:-}" ]; then candidates=("$CLANKER_DICTATE_SOCKET")
else mapfile -t candidates < <(ls -t "$dir"/clanker-dictate-"$(id -u)"-*.sock 2>/dev/null); fi

for sock in "${candidates[@]}"; do
  [ -S "$sock" ] || continue
  if [ "$(send "$sock")" = "ok" ]; then exit 0; fi
done
echo "Clanker is not listening. Open VS Code with the Clanker Controller extension first." >&2
exit 1
